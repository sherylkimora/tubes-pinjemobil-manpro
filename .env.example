# Salin file ini menjadi .env lalu isi sesuai mesin masing-masing. JANGAN commit .env
APP_ENV=development
APP_DEBUG=true

# SQL Server (XAMPP lokal). Kosongkan DB_USER/DB_PASS untuk Windows Authentication
DB_SERVER=localhost\SQLEXPRESS01
DB_NAME=pinjemobil
DB_USER=
DB_PASS=
DB_TRUST_CERT=true

# Autentikasi (JWT). Buat secret acak: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER
JWT_TTL_MINUTES=120
JWT_ISSUER=pinjemobil

# Keamanan login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Origin frontend yang boleh akses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
